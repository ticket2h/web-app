# Gateway của Ticket2h trong image web: phục vụ SPA và chuyển /api/** tới các service, để trình duyệt chỉ gọi một
# origin (không cần CORS, cookie refresh token dùng SameSite=Strict được). Proxy dev của Vite (vite.config.ts) làm y hệt.
# ${IDENTITY_UPSTREAM}, ${CORE_UPSTREAM} được image nginx thay bằng biến môi trường lúc khởi động (envsubst).

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # API nội bộ giữa các service (/internal/**) và actuator không bao giờ mở ra ngoài.
    # nginx giải mã và gộp "//" trước khi so khớp, nên "%69nternal" hay "//internal" cũng bị chặn.
    location ~ ^/api/[^/]+/(internal|actuator)(/|$) {
        return 404;
    }

    location /api/identity/ {
        proxy_pass ${IDENTITY_UPSTREAM}/;
        # identity đặt cookie refresh ở Path=/auth; trình duyệt thấy nó dưới /api/identity/auth
        proxy_cookie_path /auth /api/identity/auth;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }

    location /api/core/ {
        proxy_pass ${CORE_UPSTREAM}/;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }

    # File của Vite có hash trong tên: cache lâu dài
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Mọi đường dẫn khác là route của SPA: trả index.html, không cache để bản mới có hiệu lực ngay
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
