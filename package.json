    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "node ./scripts/gen-api-types.mjs",
    "postinstall": "momi-ui link-skill --copy --to claude"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
